{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "tmux",
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "/path/to/swarmforge/swarm check-hook" }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          { "type": "command", "command": "/path/to/swarmforge/swarm check-hook" }
        ]
      }
    ]
  }
}
